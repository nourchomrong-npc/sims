PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173
SESSION_COOKIE_SAME_SITE=lax
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_SSL=true
DB_SSL_CA=
DB_MODE=CLOUD
SYNC_ENABLED=true
SYNC_AUTO_ENABLED=true
SYNC_INTERVAL=15000
SESSION_SECRET=replace_with_a_long_random_secret
RATE_LIMIT_GENERAL_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=120
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_EXPENSIVE_WINDOW_MS=60000
RATE_LIMIT_EXPENSIVE_MAX=30
STORAGE_DRIVER=supabase
STUDENT_PHOTO_STORAGE_DIR=storage/student-photos
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=student-photos
DB_HOST=your-project.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=

# Optional separate connections for the local backend.
# Keep DB_MODE=CLOUD and the DB_* settings above for the existing cloud-only deployment.
# For local-only operation, set DB_MODE=LOCAL and configure LOCAL_DB_* below.
# For hybrid operation, set DB_MODE=HYBRID and configure both LOCAL_DB_* and CLOUD_DB_*.
# Never put these server-side credentials in client/.env or any VITE_* variable.
LOCAL_DB_HOST=
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=
LOCAL_DB_USER=
LOCAL_DB_PASSWORD=
LOCAL_DB_SSL=false
LOCAL_DB_SSL_CA=

CLOUD_DB_HOST=
CLOUD_DB_PORT=5432
CLOUD_DB_NAME=
CLOUD_DB_USER=
CLOUD_DB_PASSWORD=
CLOUD_DB_SSL=true
CLOUD_DB_SSL_CA=

# Optional synchronization worker tuning.
SYNC_BATCH_SIZE=100
SYNC_MAX_RETRY_SECONDS=900
